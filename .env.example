# Cópia deste arquivo → `.env` (que o Git ignora).
# Este .example FICA no repo: serve de documentação de quais variáveis
# a aplicação precisa, sem nunca expor os valores reais.

# --- Banco (Fase 1: Postgres do docker-compose) ---
DB_URL=jdbc:postgresql://localhost:5432/clicclic
DB_USER=clicclic
DB_PASSWORD=troque-isto

# --- AWS (Fase 4) ---
AWS_REGION=us-east-1
S3_BUCKET=clicclic-fotos-SEU-SUFIXO
# As credenciais NÃO ficam aqui: o AWS SDK lê de ~/.aws/credentials,
# criado pelo `aws configure`. Menos um lugar de onde podem vazar.

# --- JWT (Fase 2) ---
JWT_SECRET=gere-uma-chave-longa-aleatoria
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
