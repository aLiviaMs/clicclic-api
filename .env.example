# Copy this file → `.env` (which Git ignores).
# This .example file STAYS in the repo: it documents which variables
# the application needs, without ever exposing real values.

# --- Database (Phase 1: docker-compose Postgres) ---
DB_URL=jdbc:postgresql://localhost:5432/clicclic
DB_USER=clicclic
DB_PASSWORD=change-me

# --- AWS (Phase 4) ---
AWS_REGION=us-east-1
S3_BUCKET=clic-photos-838839453951-us-east-1-an
# Credentials do NOT live here: the AWS SDK reads them from ~/.aws/credentials,
# created by `aws configure`. One less place they could leak from.

# --- JWT (Phase 2) ---
JWT_SECRET=generate-a-long-random-key
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
